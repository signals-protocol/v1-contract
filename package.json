{
  "name": "signals-v1",
  "version": "0.0.0",
  "private": true,
  "description": "Signals: CLMSR-based Daily Bitcoin Range Markets",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package",
    "test": "forge test",
    "test:cov": "FOUNDRY_PROFILE=coverage forge coverage --report lcov",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write \"contracts/**/*.sol\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"contracts/**/*.sol\" \"scripts/**/*.ts\"",
    "export-abis": "node scripts/export-abis.js",
    "deploy:local": "ENV=local forge script script/actions/DeployV1.s.sol --rpc-url local --broadcast",
    "deploy:dev": "ENV=dev forge script script/actions/DeployV1.s.sol --rpc-url dev --broadcast",
    "deploy-fee-policies:dev": "ENV=dev forge script script/actions/DeployFeePolicies.s.sol --rpc-url dev --broadcast",
    "deploy-fee-policies:prod": "ENV=prod forge script script/actions/DeployFeePolicies.s.sol --rpc-url prod --broadcast",
    "deploy-impls:dev": "ENV=dev forge script script/actions/DeployImpls.s.sol --rpc-url dev --broadcast",
    "deploy-impls:prod": "ENV=prod forge script script/actions/DeployImpls.s.sol --rpc-url prod --broadcast",
    "update-modules:dev": "ENV=dev forge script script/actions/UpdateModules.s.sol --rpc-url dev --broadcast",
    "predict-create2:dev": "ENV=dev forge script script/actions/PredictCreate2.s.sol --rpc-url dev",
    "seed-vault:dev": "ENV=dev forge script script/actions/SeedVault.s.sol --rpc-url dev --broadcast",
    "fund-backstop:dev": "ENV=dev forge script script/actions/FundBackstop.s.sol --rpc-url dev --broadcast",
    "safety-check:dev": "ENV=dev forge script script/actions/SafetyCheck.s.sol --rpc-url dev",
    "safety-check:prod": "ENV=prod forge script script/actions/SafetyCheck.s.sol --rpc-url prod",
    "post-fund-check:dev": "ENV=dev forge script script/actions/PostFundCheck.s.sol --rpc-url dev",
    "prepare-safe-upgrade:dev": "ENV=dev forge script script/actions/PrepareSafeUpgrade.s.sol --rpc-url dev --broadcast",
    "prepare-safe-upgrade:prod": "ENV=prod forge script script/actions/PrepareSafeUpgrade.s.sol --rpc-url prod --broadcast",
    "set-timeline:dev": "ENV=dev forge script script/ops/SetTimeline.s.sol --rpc-url dev --broadcast",
    "create-market:dev": "ENV=dev forge script script/ops/CreateMarket.s.sol --rpc-url dev --broadcast",
    "close-market:dev": "ENV=dev forge script script/ops/CloseMarket.s.sol --rpc-url dev --broadcast",
    "deploy:integration": "forge script script/actions/DeployIntegration.s.sol --rpc-url local --broadcast",
    "verify:dev": "ENV=dev tsx scripts/actions/verify.ts",
    "verify:prod": "ENV=prod STRICT_VERIFY=1 tsx scripts/actions/verify.ts",
    "post-deploy": "tsx scripts/utils/post-deploy.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@redstone-finance/evm-connector": "^0.9.0",
    "@redstone-finance/protocol": "^0.9.0",
    "@safe-global/api-kit": "4.0.1",
    "@safe-global/protocol-kit": "6.1.2",
    "@safe-global/safe-core-sdk-types": "5.1.0",
    "@types/node": "^20.11.19",
    "dotenv": "^16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^2.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "viem": "^2.21.0"
  },
  "lint-staged": {
    "*.sol": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prb/math": "^4.1.0"
  }
}
