{
  "name": "signals-v1",
  "version": "0.0.0",
  "private": true,
  "description": "Signals: CLMSR-based Daily Bitcoin Range Markets",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package",
    "test": "forge test",
    "snapshot": "forge snapshot --no-match-test 'testFuzz|invariant_'",
    "snapshot:check": "forge snapshot --no-match-test 'testFuzz|invariant_' --check --tolerance 15",
    "test:fork:baseline": "FOUNDRY_PROFILE=fork FORK_ENV=prod forge test --match-path 'test/foundry/fork/**/*.sol' --no-match-path 'test/foundry/fork/live/**' -vvv",
    "test:fork:advisory:prod": "FORK_SKIP_V2_UPGRADE=true FOUNDRY_PROFILE=fork FORK_ENV=prod forge test --match-path 'test/foundry/fork/live/**' -vvv",
    "test:fork:dev": "FOUNDRY_PROFILE=fork FORK_ENV=dev forge test --match-path 'test/foundry/fork/**/*.sol' --no-match-path 'test/foundry/fork/live/**' -vvv",
    "test:fork:prod": "yarn test:fork:baseline",
    "test:cov": "FOUNDRY_PROFILE=coverage forge coverage --report lcov",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "forge fmt contracts script test && prettier --write \"scripts/**/*.ts\"",
    "format:check": "forge fmt --check contracts script test && prettier --check \"scripts/**/*.ts\"",
    "export-abis": "node scripts/export-abis.js",
    "storage:snapshot": "tsx scripts/storage-layout/index.ts snapshot",
    "storage:check": "tsx scripts/storage-layout/index.ts check",
    "storage:test": "tsx --test scripts/storage-layout/__tests__/*.test.ts",
    "deploy:local": "ENV=local forge script script/actions/DeployV1.s.sol --rpc-url local --broadcast",
    "deploy:dev": "ENV=dev forge script script/actions/DeployV1.s.sol --rpc-url dev --broadcast",
    "deploy-fee-policies:dev": "ENV=dev forge script script/actions/DeployFeePolicies.s.sol --rpc-url dev --broadcast",
    "deploy-fee-policies:prod": "ENV=prod forge script script/actions/DeployFeePolicies.s.sol --rpc-url prod --broadcast",
    "deploy-router:dev": "ENV=dev forge script script/actions/DeployRouter.s.sol --rpc-url dev --broadcast",
    "deploy-router:prod": "ENV=prod forge script script/actions/DeployRouter.s.sol --rpc-url prod --broadcast",
    "deploy-impls:dev": "ENV=dev forge script script/actions/DeployImpls.s.sol --rpc-url dev --broadcast",
    "deploy-impls:prod": "ENV=prod forge script script/actions/DeployImpls.s.sol --rpc-url prod --broadcast",
    "update-modules:dev": "ENV=dev forge script script/actions/UpdateModules.s.sol --rpc-url dev --broadcast",
    "predict-create2:dev": "ENV=dev forge script script/actions/PredictCreate2.s.sol --rpc-url dev",
    "seed-vault:dev": "ENV=dev forge script script/actions/SeedVault.s.sol --rpc-url dev --broadcast",
    "fund-backstop:dev": "ENV=dev forge script script/actions/FundBackstop.s.sol --rpc-url dev --broadcast",
    "safety-check:dev": "ENV=dev forge script script/actions/SafetyCheck.s.sol --rpc-url dev",
    "safety-check:prod": "ENV=prod forge script script/actions/SafetyCheck.s.sol --rpc-url prod",
    "post-fund-check:dev": "ENV=dev forge script script/actions/PostFundCheck.s.sol --rpc-url dev",
    "prepare-safe-upgrade:dev": "ENV=dev forge script script/actions/PrepareSafeUpgrade.s.sol --rpc-url dev --broadcast",
    "prepare-safe-upgrade:prod": "ENV=prod forge script script/actions/PrepareSafeUpgrade.s.sol --rpc-url prod --broadcast",
    "deploy-decommission-module:prod": "ENV=prod forge script script/actions/DeployDecommissionModule.s.sol --rpc-url prod --broadcast && tsx scripts/utils/post-deploy.ts prod deploy-decommission-module",
    "prepare-decommission-quiesce:prod": "ENV=prod forge script script/actions/PrepareDecommissionQuiesce.s.sol --rpc-url prod",
    "validate-decommission-quiesce:prod": "DECOMMISSION_QUIESCE_PLAN=releases/prod/decommission-quiesce-plan.json FORK_SKIP_V2_UPGRADE=true FOUNDRY_PROFILE=fork FORK_ENV=prod forge test --match-path 'test/foundry/fork/live/DecommissionSweepMultiSend.t.sol' --match-test 'test_exact_quiesce_plan_multisend_pauses_and_revokes_operators' -vvv",
    "propose-decommission-quiesce:prod": "yarn validate-decommission-quiesce:prod && tsx scripts/ops/safe.ts prod propose-upgrade --plan releases/prod/decommission-quiesce-plan.json",
    "prepare-decommission-sweep:prod": "ENV=prod forge script script/actions/PrepareDecommissionSweep.s.sol --rpc-url prod",
    "validate-decommission-sweep:prod": "DECOMMISSION_SWEEP_PLAN=releases/prod/decommission-sweep-plan.json FORK_SKIP_V2_UPGRADE=true FOUNDRY_PROFILE=fork FORK_ENV=prod forge test --match-path 'test/foundry/fork/live/DecommissionSweepMultiSend.t.sol' --match-test 'test_exact_plan_multisend_sweeps_core_and_restores_vault' -vvv",
    "propose-decommission-sweep:prod": "yarn validate-decommission-sweep:prod && tsx scripts/ops/safe.ts prod propose-upgrade --plan releases/prod/decommission-sweep-plan.json",
    "set-timeline:dev": "ENV=dev forge script script/ops/SetTimeline.s.sol --rpc-url dev --broadcast",
    "create-market:dev": "ENV=dev forge script script/ops/CreateMarket.s.sol --rpc-url dev --broadcast",
    "close-market:dev": "ENV=dev forge script script/ops/CloseMarket.s.sol --rpc-url dev --broadcast",
    "deploy:integration": "forge script script/actions/DeployIntegration.s.sol --rpc-url local --broadcast",
    "verify:dev": "ENV=dev tsx scripts/actions/verify.ts",
    "verify:prod": "ENV=prod STRICT_VERIFY=1 tsx scripts/actions/verify.ts",
    "post-deploy": "tsx scripts/utils/post-deploy.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@redstone-finance/evm-connector": "^0.9.0",
    "@redstone-finance/protocol": "^0.9.0",
    "@safe-global/api-kit": "4.0.1",
    "@safe-global/protocol-kit": "6.1.2",
    "@safe-global/safe-core-sdk-types": "5.1.0",
    "@types/node": "^20.11.19",
    "dotenv": "^16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "viem": "^2.21.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prb/math": "^4.1.0"
  }
}
