{
  "name": "signals-v1",
  "version": "0.0.0",
  "private": true,
  "description": "Signals: CLMSR-based Daily Bitcoin Range Markets",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package",
    "test": "hardhat test",
    "test:cov": "COVERAGE=1 hardhat coverage",
    "clean": "hardhat clean",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write \"contracts/**/*.sol\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"contracts/**/*.sol\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "deploy:local": "COMMAND=deploy:local hardhat run scripts/dispatcher.ts --network local",
    "deploy:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev COMMAND=deploy:dev hardhat run scripts/dispatcher.ts --network dev",
    "deploy:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod COMMAND=deploy:prod hardhat run scripts/dispatcher.ts --network prod",
    "upgrade:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev COMMAND=upgrade:dev hardhat run scripts/dispatcher.ts --network dev",
    "upgrade:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod COMMAND=upgrade:prod hardhat run scripts/dispatcher.ts --network prod",
    "update-modules:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev COMMAND=update-modules:dev hardhat run scripts/dispatcher.ts --network dev",
    "update-modules:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod COMMAND=update-modules:prod hardhat run scripts/dispatcher.ts --network prod",
    "prepare-safe-upgrade:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev hardhat run scripts/actions/prepare-safe-upgrade.ts --network dev",
    "prepare-safe-upgrade:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod hardhat run scripts/actions/prepare-safe-upgrade.ts --network prod",
    "deploy-fee-policies:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev COMMAND=deploy-fee-policies:dev hardhat run scripts/dispatcher.ts --network dev",
    "deploy-fee-policies:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod COMMAND=deploy-fee-policies:prod hardhat run scripts/dispatcher.ts --network prod",
    "safety-check:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev COMMAND=safety-check:dev hardhat run scripts/dispatcher.ts --network dev",
    "safety-check:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod COMMAND=safety-check:prod hardhat run scripts/dispatcher.ts --network prod",
    "verify:dev": "MANIFEST_DEFAULT_DIR=.openzeppelin/dev COMMAND=verify:dev hardhat run scripts/dispatcher.ts --network dev",
    "verify:prod": "MANIFEST_DEFAULT_DIR=.openzeppelin/prod STRICT_VERIFY=1 COMMAND=verify:prod hardhat run scripts/dispatcher.ts --network prod",
    "export-abis": "node scripts/export-abis.js",
    "forge:deploy:local": "ENV=local forge script script/actions/DeployV1.s.sol --rpc-url local --broadcast",
    "forge:deploy:dev": "ENV=dev forge script script/actions/DeployV1.s.sol --rpc-url dev --broadcast",
    "forge:deploy-fee-policies:dev": "ENV=dev forge script script/actions/DeployFeePolicies.s.sol --rpc-url dev --broadcast",
    "forge:deploy-fee-policies:prod": "ENV=prod forge script script/actions/DeployFeePolicies.s.sol --rpc-url prod --broadcast",
    "forge:deploy-impls:dev": "ENV=dev forge script script/actions/DeployImpls.s.sol --rpc-url dev --broadcast",
    "forge:deploy-impls:prod": "ENV=prod forge script script/actions/DeployImpls.s.sol --rpc-url prod --broadcast",
    "forge:update-modules:dev": "ENV=dev forge script script/actions/UpdateModules.s.sol --rpc-url dev --broadcast",
    "forge:predict-create2:dev": "ENV=dev forge script script/actions/PredictCreate2.s.sol --rpc-url dev",
    "forge:seed-vault:dev": "ENV=dev forge script script/actions/SeedVault.s.sol --rpc-url dev --broadcast",
    "forge:fund-backstop:dev": "ENV=dev forge script script/actions/FundBackstop.s.sol --rpc-url dev --broadcast",
    "forge:safety-check:dev": "ENV=dev forge script script/actions/SafetyCheck.s.sol --rpc-url dev",
    "forge:safety-check:prod": "ENV=prod forge script script/actions/SafetyCheck.s.sol --rpc-url prod",
    "forge:post-fund-check:dev": "ENV=dev forge script script/actions/PostFundCheck.s.sol --rpc-url dev",
    "forge:set-timeline:dev": "ENV=dev forge script script/ops/SetTimeline.s.sol --rpc-url dev --broadcast",
    "forge:create-market:dev": "ENV=dev forge script script/ops/CreateMarket.s.sol --rpc-url dev --broadcast",
    "forge:close-market:dev": "ENV=dev forge script script/ops/CloseMarket.s.sol --rpc-url dev --broadcast",
    "post-deploy": "ts-node scripts/utils/post-deploy.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.4",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@openzeppelin/hardhat-upgrades": "^2.3.3",
    "@redstone-finance/evm-connector": "^0.9.0",
    "@redstone-finance/protocol": "^0.9.0",
    "@safe-global/api-kit": "4.0.1",
    "@safe-global/protocol-kit": "6.1.2",
    "@safe-global/safe-core-sdk-types": "5.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/big.js": "^6.2.2",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.19",
    "@whworjs7946/clmsr-v0": "^1.13.0",
    "big.js": "^7.0.1",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "hardhat": "^2.22.3",
    "hardhat-gas-reporter": "^1.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^2.3.1",
    "solidity-coverage": "^0.8.10",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.1",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.sol": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prb/math": "^4.1.0"
  }
}
